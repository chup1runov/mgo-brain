{
  "schema_version": "1.0",
  "default_provider": "local",
  "external_provider_opt_in": true,
  "max_tools_per_question": 7,
  "max_list_items_per_tool": 20,
  "external_location_allowed_by_default": false,
  "blocked_high_volume_keys": [
    "raw_can",
    "audio",
    "video",
    "samples_raw"
  ],
  "read_only_tools": [
    "get_live_state",
    "get_engine_health",
    "get_cvt_health",
    "get_battery_health",
    "get_start_history",
    "get_recent_trips",
    "compare_trips",
    "get_fault_events",
    "get_service_plan",
    "get_baselines",
    "get_source_status"
  ],
  "forbidden_control_domains": [
    "brakes",
    "steering",
    "throttle",
    "starter",
    "glow_control",
    "gear_selection",
    "speed_limiter",
    "factory_can_transmit"
  ]
}
