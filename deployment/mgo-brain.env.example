# MGO Brain deployment environment
MGO_BRAIN_DATA_DIR=/var/lib/mgo-brain
MGO_BRAIN_CONFIG_DIR=/etc/mgo-brain
MGO_BRAIN_HOST=0.0.0.0
MGO_BRAIN_PORT=8080

# Ask MGO / AI Gateway
# Local fallback is the safe default and requires no external service.
MGO_AI_PROVIDER=local
# Optional cloud mode:
# MGO_AI_PROVIDER=openai
# MGO_AI_MODEL=gpt-5.6-terra
# MGO_AI_REASONING=low
# Set OPENAI_API_KEY as a deployment secret/environment variable. Never commit it.
